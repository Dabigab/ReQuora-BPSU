# Copy this file to .env before running the server:
#   Windows:   copy .env.example .env
#   Mac/Linux: cp .env.example .env

PORT=5000

# Secret used to sign login tokens. Use a long random value (32+ characters).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_secret_before_deploying
JWT_EXPIRES_IN=7d

# Default admin account, created automatically the first time the server runs
ADMIN_NAME=BPSU Lost and Found Admin
ADMIN_EMAIL=admin@bpsu.edu.ph
ADMIN_PASSWORD=Admin@123

# Supabase (REQUIRED in production) --------------------------------------
# Without these, ReQuora keeps data and photos on the server's own disk, and
# hosts like Render erase that disk -> photos and records disappear.
# Find them in Supabase: Project Settings -> API (URL) and API Keys.
# Use the SECRET / service_role key here. NEVER put it in frontend files or GitHub.
# SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_or_secret_key
# SUPABASE_BUCKET=item-images

# Optional ------------------------------------------------------------
# Only allow these websites to call the API (comma separated). Leave empty
# while developing. Set it to your deployed frontend URL in production.
# CORS_ORIGIN=https://your-frontend.netlify.app

# Serve the frontend folder from this server too (default: yes, if it exists)
# SERVE_FRONTEND=true

# Set to 1 when running behind a proxy/load balancer (Render, Railway, nginx)
# TRUST_PROXY=1

# NODE_ENV=production

# Appointment places (BPSU Main Campus ONLY) ---------------------------------
# Verified meeting places inside the Main Campus, separated by semicolons.
# Fill this in with the places the project administrator confirmed. When it is
# set, administrators can only choose from this list. When empty, they type a
# place and must confirm it is inside the Main Campus.
# APPOINTMENT_LOCATIONS=Place one;Place two
